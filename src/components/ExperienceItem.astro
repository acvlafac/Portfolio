---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<div class="relative mx-8 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-primary-200 dark:before:border-primary-800 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4">
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-primary-500 -left-[42px] absolute rounded-full text-5xl">&bull;</span>
      <h3 class="text-xl font-bold text-primary-600 dark:text-primary-400">{title}</h3>
      <h4 class="font-semibold text-xl text-neutral-700 dark:text-neutral-200">{company}</h4>
      <time class="p-0 m-0 text-sm text-neutral-500 dark:text-neutral-400 bg-primary-50 dark:bg-primary-900/20 px-3 py-1 rounded-full inline-block mt-2">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-2 pb-4 text-neutral-600 dark:text-neutral-300 md:col-span-3">
    <div class="bg-neutral-50 dark:bg-neutral-800/50 p-6 rounded-xl border border-neutral-200 dark:border-neutral-700">
      {description}
    </div>
    {
      link && (
        <LinkInline href={link} class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300">
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>

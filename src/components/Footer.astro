  <div class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4">
    <span class="text-sm sm:text-center text-neutral-700/90 dark:text-neutral-200/90">
      &copy; {currentYear}
      <a href="#" class="hover:underline text-primary-600 dark:text-primary-400">Héctor Antonio Cañas Velasquez</a>. Todos los derechos reservados
    </span>
    <ul class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-neutral-100/90 sm:mt-0">
      <li>
        <a href="/#sobre-mi" class="hover:underline me-4 md:me-6 text-neutral-600 hover:text-primary-600 dark:text-neutral-300 dark:hover:text-primary-400 rounded-full px-2 py-1 focus:outline-none focus-visible:ring focus-visible:ring-primary-300">Sobre mí</a>
      </li>
      <li>
        <a id="contacto" href="mailto:acvlafac@yahoo.es" class="hover:underline text-neutral-600 hover:text-primary-600 dark:text-neutral-300 dark:hover:text-primary-400 rounded-full px-2 py-1 focus:outline-none focus-visible:ring focus-visible:ring-primary-300">Contacto</a>

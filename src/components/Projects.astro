---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  FARMACIA: {
    name: "Farmacia Hospitalaria",
    class: "bg-primary-500 text-white",
    icon: null,
  },
  GESTION: {
    name: "Gestión Farmacéutica",
    class: "bg-accent-500 text-white",
    icon: null,
  },
  DOCENCIA: {
    name: "Docencia Universitaria",
    class: "bg-primary-600 text-white",
    icon: null,
  },
};
const PROJECTS = [
  {
    title: "Regencia de Farmacia Hospitalaria",
    description:
      "Desempeño de la regencia de farmacia hospitalaria en multiples hospitales tanto publicos como privados, realizando la gestión farmacéutica y control de medicamentos especializados.",
    link: "",
  image: `${import.meta.env.BASE_URL}projects/citostaticos.webp`,
    tags: [TAGS.FARMACIA, TAGS.GESTION],
  },
  {
    title: "Manual de Procedimientos de Farmacia Hospitalaria",
    description:
      "Elaboración de manuales de procedimientos para servicios de farmacia hospitalaria, incluyendo protocolos de calidad, control de medicamentos y gestión de personal farmacéutico.",
    link: "",
    github: "",
  image: `${import.meta.env.BASE_URL}projects/farmacia.webp`,
    tags: [TAGS.FARMACIA, TAGS.GESTION],
  },
  {
    title: "Asesoría Universitaria en Citostáticos",
    description:
      "Asesoría especializada en trabajos de graduación sobre preparación y control de citostáticos, nutrición parenteral y farmacovigilancia para estudiantes de Química y Farmacia.",
    link: "",
  image: `${import.meta.env.BASE_URL}projects/citostaticos.webp`,
    tags: [TAGS.FARMACIA, TAGS.DOCENCIA],
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-primary-200 dark:lg:border-primary-800 lg:hover:border-primary-300 dark:lg:hover:border-primary-700 lg:hover:bg-primary-50/50 dark:lg:hover:bg-primary-900/20">
            <img
              alt="Proyecto farmacéutico"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-2 px-4 font-medium`}
                  >
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-neutral-600 dark:text-neutral-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton
                  href={github}
                  class="bg-primary-500 hover:bg-primary-600 text-white"
                >
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton
                  href={link}
                  class="bg-accent-500 hover:bg-accent-600 text-white"
                >
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

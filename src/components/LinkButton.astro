---
const { href, class: className } = Astro.props;
---

<a
    target="_blank"
    href={href}
    role="link"
    class={`inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium transition transform-gpu rounded-xl focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-primary-500 focus-visible:ring-offset-2 active:scale-95 ${className || 'bg-gradient-to-br from-primary-100 to-primary-200 text-primary-800 shadow-sm hover:from-primary-200 hover:to-primary-300 dark:from-primary-900 dark:to-primary-800 dark:text-primary-100 dark:shadow-md'}`}
>
    <slot />
</a>

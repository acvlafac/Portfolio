---
const { class: cls, ...rest } = Astro.props;
---

<a
  {...rest}
  target="_blank"
  rel="noopener noreferrer"
  role="link"
  class={`inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium transition transform-gpu rounded-full focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-primary-500 focus-visible:ring-offset-2 active:scale-95 ${cls || 'bg-gradient-to-r from-primary-100 to-primary-200 text-primary-800 shadow hover:from-primary-200 hover:to-primary-300 dark:from-primary-900 dark:to-primary-800 dark:text-primary-100 dark:shadow-lg'}`}
>
  <slot />
</a>
